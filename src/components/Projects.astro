---
import { cvData } from '../data/cv';

const projectFocus: Record<string, { challenge: string; solution: string }> = {
  lifeos: {
    challenge: 'Unificar finanzas personales, hábitos e IA en un único sistema escalable.',
    solution: 'Arquitectura full-stack modular con backend API, almacenamiento relacional y automatizaciones.',
  },
  'Motorcycle Accident Risk Analysis & Severity Prediction': {
    challenge: 'Analizar gran volumen de datos de tráfico y predecir severidad de accidentes.',
    solution: 'Pipeline de análisis y modelos de ML para extraer patrones y mejorar la toma de decisiones.',
  },
  'sky-map': {
    challenge: 'Mostrar vuelos en tiempo real con procesamiento continuo de datos.',
    solution: 'Ingesta streaming con Kafka + visualización interactiva conectada a backend en tiempo real.',
  },
  'polymarket-bot': {
    challenge: 'Automatizar decisiones sobre un mercado de predicción descentralizado.',
    solution: 'Bot con integración API para ejecutar flujos automáticos y monitorizar oportunidades.',
  },
};
---

<section id="projects" class="projects">
  <div class="container">
    <h2>Proyectos</h2>
    <div class="projects-list">
      {cvData.projects.map((project) => (
        <div class="project-card">
          <div class="project-content">
            <div class="project-header">
              <h3>{project.name}</h3>
              <div class="project-links">
                {project.github && (
                  <a href={project.github} target="_blank" rel="noopener noreferrer" class="project-link">
                    GitHub
                  </a>
                )}
                {project.demo && (
                  <a href={project.demo} target="_blank" rel="noopener noreferrer" class="project-link">
                    Demo
                  </a>
                )}
              </div>
            </div>
            <p class="project-description">{project.description}</p>
            <div class="project-block">
              <h4>Problema</h4>
              <p>{projectFocus[project.name]?.challenge || 'Resolver un caso real con enfoque backend, cloud y datos.'}</p>
            </div>
            <div class="project-block">
              <h4>Solución</h4>
              <p>{projectFocus[project.name]?.solution || 'Diseño e implementación de una solución técnica escalable y mantenible.'}</p>
            </div>
            <div class="project-tech">
              {project.technologies.map((tech) => (
                <span class="tech-tag">{tech}</span>
              ))}
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .projects {
    background: var(--color-bg-alt);
  }

  .projects h2 {
    text-align: center;
    margin-bottom: var(--spacing-md);
  }

  .projects-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--spacing-md);
    max-width: 1080px;
    margin: 0 auto;
  }

  .project-card {
    background-color: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: var(--border-radius);
    padding: var(--spacing-md);
    box-shadow: var(--shadow);
    transition: border-color 0.2s ease, transform 0.2s ease;
    display: flex;
    width: 100%;
  }

  .project-card:hover {
    transform: translateY(-2px);
    border-color: var(--color-primary-light);
  }

  .project-content {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-sm);
    width: 100%;
  }

  .project-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: var(--spacing-md);
    flex-wrap: wrap;
  }

  .project-content h3 {
    margin: 0;
    color: var(--color-text);
    flex: 1;
  }

  .project-description {
    color: var(--color-text-light);
    line-height: 1.7;
    margin: var(--spacing-xs) 0;
  }

  .project-block {
    border: 1px solid var(--color-border);
    background: var(--color-bg-alt);
    border-radius: var(--border-radius-sm);
    padding: 0.7rem 0.8rem;
  }

  .project-block h4 {
    font-size: 0.76rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-primary-dark);
    margin-bottom: 0.35rem;
  }

  .project-block p {
    font-size: 0.94rem;
    color: var(--color-text-light);
    line-height: 1.65;
  }

  .project-tech {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-xs);
    margin-top: var(--spacing-xs);
  }

  .tech-tag {
    background-color: var(--color-bg-alt);
    color: var(--color-text-light);
    padding: 0.35rem 0.85rem;
    border-radius: 1rem;
    font-size: 0.85rem;
    font-weight: 500;
    border: 1px solid var(--color-border);
    transition: border-color 0.2s ease, color 0.2s ease;
  }

  .tech-tag:hover {
    color: var(--color-primary);
    border-color: var(--color-primary-light);
  }

  .project-links {
    display: flex;
    gap: var(--spacing-sm);
    flex-shrink: 0;
  }

  .project-link {
    color: var(--color-primary);
    font-weight: 500;
    transition: color 0.2s;
    white-space: nowrap;
  }

  .project-link:hover {
    color: var(--color-primary-dark);
    text-decoration: underline;
  }

  @media (max-width: 768px) {
    .projects-list {
      grid-template-columns: 1fr;
    }

    .project-header {
      flex-direction: column;
      align-items: flex-start;
    }

    .project-links {
      width: 100%;
      justify-content: flex-start;
    }
  }
</style>
