---
import { cvData } from '../data/cv';
---

<header class="header">
  <nav class="nav container">
    <div class="nav-brand">
      <a href="/">{cvData.personal.name}</a>
    </div>

    <button class="nav-toggle" aria-label="Abrir menú">
      ☰
    </button>

    <button class="theme-toggle" aria-label="Cambiar tema" title="Cambiar tema">
      <span class="theme-toggle-icon" aria-hidden="true">☀</span>
    </button>

    <ul class="nav-links">
      <li><a href="#about">Sobre mí</a></li>
      <li><a href="#experience">Experiencia</a></li>
      <li><a href="#skills">Habilidades</a></li>
      <li><a href="#certifications">Certificaciones</a></li>
      <li><a href="#projects">Proyectos</a></li>
      <li><a href="#contact">Contacto</a></li>
    </ul>
  </nav>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.nav-toggle');
  const links = document.querySelector<HTMLElement>('.nav-links');
  const themeToggle = document.querySelector('.theme-toggle');
  const themeIcon = document.querySelector('.theme-toggle-icon');

  toggle?.addEventListener('click', () => {
    links?.classList.toggle('open');
  });

  const updateThemeIcon = (theme: string) => {
    if (!themeIcon) return;
    themeIcon.textContent = theme === 'light' ? '🌙' : '☀';
  };

  const currentTheme = document.documentElement.getAttribute('data-theme') || 'dark';
  updateThemeIcon(currentTheme);

  themeToggle?.addEventListener('click', () => {
    const activeTheme = document.documentElement.getAttribute('data-theme') || 'dark';
    const nextTheme = activeTheme === 'dark' ? 'light' : 'dark';
    document.documentElement.setAttribute('data-theme', nextTheme);
    localStorage.setItem('theme', nextTheme);
    updateThemeIcon(nextTheme);
  });
</script>

<style>
  .header {
    position: sticky;
    top: 0;
    background-color: color-mix(in srgb, var(--color-bg-alt) 88%, transparent);
    border-bottom: 1px solid var(--color-border);
    z-index: 100;
    backdrop-filter: blur(12px);
    transition: background-color 0.25s ease, border-color 0.25s ease;
  }

  .nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--spacing-sm);
    padding: var(--spacing-sm) var(--spacing-md);
  }

  .nav-brand a {
    font-size: 1.15rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--color-text);
    transition: color 0.2s ease;
  }

  .nav-links {
    display: flex;
    list-style: none;
    gap: var(--spacing-md);
    margin-left: auto;
  }

  .nav-links a {
    color: var(--color-text);
    font-weight: 500;
    transition: color 0.2s ease;
    position: relative;
    padding: 0.5rem 0;
  }

  .nav-links a::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 0;
    height: 2px;
    background: var(--color-primary);
    transition: width 0.2s ease;
  }

  .nav-links a:hover {
    color: var(--color-primary);
  }

  .nav-links a:hover::after {
    width: 100%;
  }

  .theme-toggle {
    width: 2.4rem;
    height: 2.4rem;
    border-radius: 999px;
    border: 1px solid var(--color-border-light);
    background: var(--color-bg-card);
    color: var(--color-text);
    cursor: pointer;
    display: grid;
    place-items: center;
    transition: background-color 0.2s ease, border-color 0.2s ease, transform 0.2s ease;
  }

  .theme-toggle:hover {
    border-color: var(--color-primary);
    background: var(--color-bg-card-hover);
    transform: translateY(-1px);
  }

  .theme-toggle-icon {
    font-size: 1rem;
    line-height: 1;
  }

  .nav-toggle {
    display: none;
    font-size: 1.8rem;
    background: none;
    border: none;
    color: var(--color-text);
    cursor: pointer;
  }

  /* MOBILE */
  @media (max-width: 768px) {
    .nav {
      position: relative;
    }

    .nav-toggle {
      display: block;
    }

    .theme-toggle {
      order: 1;
    }

    .nav-links {
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      flex-direction: column;
      background-color: color-mix(in srgb, var(--color-bg-alt) 92%, transparent);
      border-bottom: 1px solid var(--color-border);
      padding: var(--spacing-md);
      gap: var(--spacing-sm);
      display: none;
      margin-left: 0;
    }

    .nav-links.open {
      display: flex;
    }

    .nav-links a {
      padding: 0.75rem 0;
      font-size: 1rem;
    }
  }
</style>
