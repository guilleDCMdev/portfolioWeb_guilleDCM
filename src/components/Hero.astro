---
import { cvData } from '../data/cv';
---

<section class="hero">
  <div class="container">
    <div class="hero-content">
      <h1 class="hero-title">{cvData.personal.name}</h1>
      <p class="hero-subtitle">{cvData.personal.title}</p>
      <div class="hero-links">
        <a href="#contact" class="btn">Contactar</a>
        <a href={cvData.personal.linkedin} target="_blank" rel="noopener noreferrer" class="btn">
          LinkedIn
        </a>
      </div>
      <div class="hero-social">
        {cvData.personal.github && (
          <a href={cvData.personal.github} target="_blank" rel="noopener noreferrer" aria-label="GitHub">
            GitHub
          </a>
        )}
        {cvData.personal.linkedin && (
          <a href={cvData.personal.linkedin} target="_blank" rel="noopener noreferrer" aria-label="LinkedIn">
            LinkedIn
          </a>
        )}
        {cvData.personal.email && (
          <a href={`mailto:${cvData.personal.email}`} aria-label="Email">
            Email
          </a>
        )}
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    padding: var(--spacing-xl) 0;
    text-align: center;
  }

  .hero-content {
    max-width: 800px;
    margin: 0 auto;
  }

  .hero-title {
    margin-bottom: var(--spacing-sm);
    color: var(--color-text);
    animation: fadeInUp 0.8s ease-out;
  }

  .hero-subtitle {
    font-size: 1.5rem;
    color: var(--color-text-light);
    margin-bottom: var(--spacing-md);
  }

  .hero-description {
    font-size: 1.1rem;
    color: var(--color-text-light);
    margin-bottom: var(--spacing-lg);
    line-height: 1.8;
  }

  .hero-links {
    display: flex;
    gap: var(--spacing-sm);
    justify-content: center;
    margin-bottom: var(--spacing-lg);
    flex-wrap: wrap;
  }

  .hero-social {
    display: flex;
    gap: var(--spacing-md);
    justify-content: center;
    flex-wrap: wrap;
  }

  .hero-social a {
    color: var(--color-text-light);
    transition: all 0.3s ease;
    padding: 0.5rem 1rem;
    border-radius: var(--border-radius-sm);
    border: 1px solid transparent;
  }

  .hero-social a:hover {
    color: var(--color-primary);
    background-color: var(--color-bg-card);
    border-color: var(--color-border-green);
    transform: translateY(-2px);
    box-shadow: var(--shadow);
  }
</style>

