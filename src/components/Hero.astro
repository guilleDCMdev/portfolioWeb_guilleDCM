---
import { cvData } from '../data/cv';
---

<section class="hero">
  <div class="container">
    <div class="hero-content">
      <h1 class="hero-title">{cvData.personal.name}</h1>
      <p class="hero-subtitle">{cvData.personal.title}</p>
      <div class="hero-links">
        <a href="#contact" class="btn">Contactar</a>
        <a href={cvData.personal.linkedin} target="_blank" rel="noopener noreferrer" class="btn">
          LinkedIn
        </a>
      </div>
      <div class="hero-social">
        {cvData.personal.github && (
          <a href={cvData.personal.github} target="_blank" rel="noopener noreferrer" aria-label="GitHub">
            GitHub
          </a>
        )}
        {cvData.personal.linkedin && (
          <a href={cvData.personal.linkedin} target="_blank" rel="noopener noreferrer" aria-label="LinkedIn">
            LinkedIn
          </a>
        )}
        {cvData.personal.email && (
          <a href={`mailto:${cvData.personal.email}`} aria-label="Email">
            Email
          </a>
        )}
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    padding: calc(var(--spacing-xl) + 1rem) 0 var(--spacing-xl);
    text-align: left;
  }

  .hero-content {
    max-width: 760px;
    margin: 0 auto;
  }

  .hero-title {
    margin-bottom: var(--spacing-sm);
    color: var(--color-text);
    animation: fadeInUp 0.8s ease-out;
    text-wrap: balance;
  }

  .hero-subtitle {
    font-size: 1.22rem;
    color: var(--color-text-light);
    margin-bottom: 2.2rem;
    max-width: 62ch;
    line-height: 1.75;
  }

  .hero-description {
    font-size: 1.1rem;
    color: var(--color-text-light);
    margin-bottom: var(--spacing-lg);
    line-height: 1.8;
  }

  .hero-links {
    display: flex;
    gap: var(--spacing-sm);
    justify-content: flex-start;
    margin-bottom: var(--spacing-lg);
    flex-wrap: wrap;
  }

  .hero-social {
    display: flex;
    gap: var(--spacing-md);
    justify-content: flex-start;
    flex-wrap: wrap;
  }

  .hero-social a {
    color: var(--color-text-light);
    transition: color 0.2s ease, border-color 0.2s ease;
    padding: 0.45rem 0.9rem;
    border-radius: 999px;
    border: 1px solid transparent;
    font-size: 0.92rem;
  }

  .hero-social a:hover {
    color: var(--color-primary);
    border-color: var(--color-border);
    background-color: var(--color-bg-alt);
  }

  @media (max-width: 768px) {
    .hero {
      text-align: center;
    }

    .hero-links,
    .hero-social {
      justify-content: center;
    }
  }
</style>

