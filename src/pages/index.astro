---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import About from '../components/About.astro';
import Experience from '../components/Experience.astro';
import Impact from '../components/Impact.astro';
import Projects from '../components/Projects.astro';
import Skills from '../components/Skills.astro';
import Certifications from '../components/Certifications.astro';
import Contact from '../components/Contact.astro';
import { cvData } from '../data/cv';
---

<BaseLayout title="Portfolio - Guillermo de Carlos Muñoz" description="Portfolio profesional de Guillermo de Carlos Muñoz">
  <Header />
  <main>
    <Hero />
    <About />
    <Experience />
    <Impact />
    <Skills />
    <Certifications />
    <Projects />
    <Contact />
  </main>
  <footer class="footer">
    <div class="container">
      <p>&copy; {new Date().getFullYear()} {cvData.personal.name}. Todos los derechos reservados.</p>
      <div class="footer-links">
        {cvData.personal.github && (
          <a href={cvData.personal.github} target="_blank" rel="noopener noreferrer">GitHub</a>
        )}
        {cvData.personal.linkedin && (
          <a href={cvData.personal.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a>
        )}
        {cvData.personal.email && (
          <a href={`mailto:${cvData.personal.email}`}>Email</a>
        )}
      </div>
    </div>
  </footer>

  <style>
    main {
      padding-bottom: var(--spacing-xl);
    }

    main section:first-child {
      border-top: none;
    }

    .footer {
      text-align: center;
      padding: var(--spacing-xl) 0;
      background-color: transparent;
      border-top: 1px solid var(--color-border);
      color: var(--color-text-light);
      position: relative;
      z-index: 1;
    }

    .footer-links {
      display: flex;
      justify-content: center;
      gap: var(--spacing-md);
      margin-top: var(--spacing-sm);
      flex-wrap: wrap;
    }

    .footer-links a {
      color: var(--color-text-light);
      transition: color 0.2s ease, border-color 0.2s ease;
      padding: 0.45rem 0.9rem;
      border-radius: 999px;
      border: 1px solid transparent;
    }

    .footer-links a:hover {
      color: var(--color-primary);
      border-color: var(--color-border);
      background-color: var(--color-bg-alt);
    }
  </style>
</BaseLayout>

